<?xml version="1.0" encoding="utf-8"?>
<!-- Saved artworks and their metadata stay on the device and move with it, but
     are kept out of cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="artworks/" />
    </cloud-backup>
</data-extraction-rules>
